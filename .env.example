# Copy to .env and fill in. .env is gitignored — never commit real values.
#   cp .env.example .env

# ── Domain ───────────────────────────────────────────────────────────────────
# The hostname this site answers on. Must already point at this server's IP
# before you start the stack, or Caddy cannot obtain a certificate.
DOMAIN=example.com

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres is never published to the host, but use a strong password anyway.
# Use hex, not base64: this value is interpolated into a database URL, and the
# "+" and "/" that base64 produces would corrupt it.
#   openssl rand -hex 24
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio

# ── Security ─────────────────────────────────────────────────────────────────
# Signs session tokens and salts the analytics visitor hash. Changing it logs
# everyone out and resets visitor counts.
#   openssl rand -hex 32
SECRET_KEY=

# ── Admin account ────────────────────────────────────────────────────────────
# Used once, to create the admin account the first time the API starts. Editing
# these later has no effect — change your password from /admin/settings instead.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# ── Contact form email (optional) ────────────────────────────────────────────
# Leave SMTP_HOST empty to skip sending. Messages are still stored and readable
# at /admin/messages, so nothing is lost either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
# Where contact-form notifications are delivered. Defaults to ADMIN_EMAIL.
CONTACT_TO_EMAIL=
