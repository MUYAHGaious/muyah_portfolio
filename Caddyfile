# www redirects to the apex so the site has one canonical hostname. Caddy issues
# a certificate for this name too, which it can only do if www resolves here —
# keep the www CNAME/A record pointed at this server alongside the apex.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	# Caddy obtains and renews the certificate automatically once DOMAIN
	# resolves to this server. Nothing here needs editing for TLS.

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Uploaded files are served straight off the shared volume, so images never
	# pass through Python or Node.
	handle_path /uploads/* {
		root * /srv/uploads
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
